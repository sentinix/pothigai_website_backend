# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/pothigai
# Long random string (at least 32 characters). Never commit the real value.
JWT_SECRET=
# Public storefront origin, no trailing slash (used for canonical URLs in audits)
SITE_URL=https://www.example.com
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=https://www.example.com
# Public origin of this API (used to build absolute image URLs)
PUBLIC_API_URL=https://api.example.com
PORT=4000
# Reverse proxies in front of the API whose X-Forwarded-For entries are trusted
# (1 behind a single proxy; 2 on Render when traffic comes through Vercel)
TRUST_PROXY_HOPS=1
# Directory for uploaded product/blog images (must be persistent storage in production)
UPLOAD_DIR=./uploads
# Optional: used by `npm run db:seed` to create the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
